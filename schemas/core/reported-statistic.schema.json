{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gregrr.github.io/fermentation-json/schemas/0.1.0/core/reported-statistic.schema.json",
  "title": "FermentationJSON reported statistic",
  "$anchor": "reportedStatistic",
  "description": "Identifies a statistic explicitly reported by a source.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "single_observation"
        }
      },
      "unevaluatedProperties": false
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "average"
        }
      },
      "unevaluatedProperties": false
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "running_annual_average"
        }
      },
      "unevaluatedProperties": false
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "locational_running_annual_average"
        }
      },
      "unevaluatedProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "percentile"
      ],
      "properties": {
        "type": {
          "const": "percentile"
        },
        "percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "unevaluatedProperties": false
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "highest"
        }
      },
      "unevaluatedProperties": false
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "lowest"
        }
      },
      "unevaluatedProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "const": "other"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "unevaluatedProperties": false
    }
  ]
}
