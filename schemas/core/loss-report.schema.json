{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FermentationJSON transformation loss report",
  "$anchor": "lossReport",
  "type": "object",
  "required": [
    "source",
    "target",
    "entries"
  ],
  "properties": {
    "source": {
      "$ref": "format-descriptor.schema.json#formatDescriptor"
    },
    "target": {
      "$ref": "format-descriptor.schema.json#formatDescriptor"
    },
    "compatibility_profile_id": {
      "$ref": "identity.schema.json#schemaId"
    },
    "compatibility_profile_version": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#lossEntry"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "diagnostic.schema.json#diagnostic"
      }
    },
    "extensions": {
      "$ref": "extension.schema.json#extensionContainer"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "loss_entry": {
      "$anchor": "lossEntry",
      "type": "object",
      "required": [
        "category",
        "severity"
      ],
      "properties": {
        "category": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "omitted_information",
                "unsupported_object_or_field",
                "unsupported_extension",
                "unsupported_semantic_qualifier",
                "unsupported_unit_or_reporting_basis",
                "precision_reduction_or_rounding",
                "approximation",
                "many_to_one_mapping",
                "ambiguous_mapping"
              ]
            },
            {
              "type": "string",
              "format": "uri",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
            }
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "informational",
            "warning",
            "error",
            "fatal"
          ]
        },
        "source_path": {
          "type": "string"
        },
        "target_path": {
          "type": "string"
        },
        "source_object": {
          "$ref": "reference.schema.json#dataReference"
        },
        "affected_concept": {
          "$ref": "vocabulary-identifier.schema.json#vocabularyIdentifier"
        },
        "transformation": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        },
        "extensions": {
          "$ref": "extension.schema.json#extensionContainer"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
