{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FermentationJSON quantity",
  "$anchor": "quantity",
  "type": "object",
  "required": [
    "quantity_kind",
    "canonical"
  ],
  "properties": {
    "quantity_kind": {
      "$ref": "vocabulary-identifier.schema.json#vocabularyIdentifier"
    },
    "canonical": {
      "$ref": "#canonicalRepresentation"
    },
    "reported": {
      "$ref": "#reportedRepresentation"
    },
    "epistemic_state": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "reported",
          "measured",
          "observed",
          "user_entered",
          "calculated",
          "derived",
          "estimated",
          "inferred",
          "predicted",
          "target",
          "specification",
          "nominal",
          "default"
        ]
      }
    },
    "analytical_limits": {
      "type": "array",
      "items": {
        "$ref": "#analyticalLimit"
      }
    },
    "derivation": {
      "$ref": "#derivation"
    },
    "provenance": {
      "$ref": "provenance.schema.json#provenance"
    },
    "extensions": {
      "$ref": "extension.schema.json#extensionContainer"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "reporting_basis": {
      "$anchor": "reportingBasis",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "vocabulary-identifier.schema.json#vocabularyIdentifier"
        },
        "substance": {
          "$ref": "vocabulary-identifier.schema.json#vocabularyIdentifier"
        },
        "description": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false
    },
    "canonical_representation": {
      "$anchor": "canonicalRepresentation",
      "type": "object",
      "required": [
        "form",
        "unit"
      ],
      "properties": {
        "form": {
          "$ref": "result-form.schema.json#resultForm"
        },
        "unit": {
          "$ref": "vocabulary-identifier.schema.json#vocabularyIdentifier"
        },
        "basis": {
          "$ref": "#reportingBasis"
        }
      },
      "unevaluatedProperties": false
    },
    "reported_representation": {
      "$anchor": "reportedRepresentation",
      "type": "object",
      "required": [
        "form",
        "unit"
      ],
      "properties": {
        "form": {
          "$ref": "result-form.schema.json#resultForm"
        },
        "unit": {
          "$ref": "vocabulary-identifier.schema.json#vocabularyIdentifier"
        },
        "basis": {
          "$ref": "#reportingBasis"
        },
        "original_text": {
          "type": "string"
        },
        "decimal_places": {
          "type": "integer",
          "minimum": 0
        },
        "significant_figures": {
          "type": "integer",
          "minimum": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "original_unit_text": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false
    },
    "analytical_limit": {
      "$anchor": "analyticalLimit",
      "type": "object",
      "required": [
        "type",
        "quantity"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "detection_limit",
            "reporting_limit",
            "quantification_limit"
          ]
        },
        "quantity": {
          "type": "object",
          "required": [
            "form",
            "unit"
          ],
          "properties": {
            "form": {
              "type": "object",
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "const": "exact"
                },
                "value": {
                  "type": "number"
                }
              },
              "unevaluatedProperties": false
            },
            "unit": {
              "$ref": "vocabulary-identifier.schema.json#vocabularyIdentifier"
            },
            "basis": {
              "$ref": "#reportingBasis"
            }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "derivation": {
      "$anchor": "derivation",
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "source_references": {
          "type": "array",
          "items": {
            "$ref": "reference.schema.json#dataReference"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "software": {
          "$ref": "provenance.schema.json#softwareIdentity"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
