{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gregrr.github.io/fermentation-json/schemas/0.1.0/core/vocabulary-identifier.schema.json",
  "title": "FermentationJSON vocabulary identifier",
  "$anchor": "vocabularyIdentifier",
  "description": "A FermentationJSON core vocabulary token or an absolute URI identifying an extension vocabulary term.",
  "oneOf": [
    {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    {
      "type": "string",
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
    }
  ]
}
