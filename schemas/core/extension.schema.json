{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gregrr.github.io/fermentation-json/schemas/0.1.0/core/extension.schema.json",
  "title": "FermentationJSON extension container",
  "$anchor": "extensionContainer",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "format": "uri",
    "minLength": 1,
    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
  },
  "additionalProperties": {
    "$ref": "#extensionEntry"
  },
  "$defs": {
    "extension_entry": {
      "$anchor": "extensionEntry",
      "type": "object",
      "required": [
        "required",
        "data"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "data": true
      },
      "unevaluatedProperties": false
    }
  }
}
