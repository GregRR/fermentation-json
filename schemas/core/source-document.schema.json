{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FermentationJSON source-document metadata",
  "$anchor": "sourceDocument",
  "type": "object",
  "properties": {
    "publisher": {
      "$ref": "#namedParty"
    },
    "analysis_provider": {
      "$ref": "#namedParty"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publication_date": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}$"
        }
      ]
    },
    "source_uri": {
      "type": "string",
      "format": "uri"
    },
    "retrieval_date": {
      "type": "string",
      "format": "date"
    },
    "locator": {
      "$ref": "#sourceLocator"
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "$ref": "extension.schema.json#extensionContainer"
    }
  },
  "minProperties": 1,
  "unevaluatedProperties": false,
  "$defs": {
    "named_party": {
      "$anchor": "namedParty",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        }
      },
      "unevaluatedProperties": false
    },
    "source_locator": {
      "$anchor": "sourceLocator",
      "type": "object",
      "properties": {
        "page": {
          "type": [
            "string",
            "integer"
          ]
        },
        "table": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "record": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "json_pointer": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "minProperties": 1,
      "unevaluatedProperties": false
    }
  }
}
