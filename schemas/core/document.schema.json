{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gregrr.github.io/fermentation-json/schemas/0.1.0/core/document.schema.json",
  "title": "FermentationJSON document envelope",
  "$anchor": "documentEnvelope",
  "description": "Reusable FermentationJSON document envelope. This base schema remains composable; concrete document schemas must close the root object.",
  "type": "object",
  "required": [
    "specification_version",
    "document_type",
    "schema_id",
    "document_id",
    "content"
  ],
  "properties": {
    "specification_version": {
      "$ref": "identity.schema.json#semanticVersion"
    },
    "document_type": {
      "type": "string",
      "minLength": 1
    },
    "schema_id": {
      "$ref": "identity.schema.json#schemaId"
    },
    "document_id": {
      "$ref": "identity.schema.json#documentId"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "declaration.schema.json#artifactDeclaration"
      },
      "uniqueItems": true
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "declaration.schema.json#artifactDeclaration"
      },
      "uniqueItems": true
    },
    "vocabularies": {
      "description": "Additional vocabulary artifacts not already fixed by the applicable core schema set, profile, or module.",
      "type": "array",
      "items": {
        "$ref": "declaration.schema.json#vocabularyDeclaration"
      },
      "uniqueItems": true
    },
    "metadata": {
      "$ref": "document-metadata.schema.json#documentMetadata"
    },
    "content": true,
    "extensions": {
      "$ref": "extension.schema.json#extensionContainer"
    }
  }
}
