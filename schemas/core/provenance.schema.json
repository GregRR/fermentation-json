{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FermentationJSON provenance",
  "$anchor": "provenance",
  "type": "object",
  "properties": {
    "source_document": {
      "$ref": "source-document.schema.json#sourceDocument"
    },
    "source_reference": {
      "$ref": "reference.schema.json#dataReference"
    },
    "source_locator": {
      "$ref": "source-document.schema.json#sourceLocator"
    },
    "person": {
      "type": "string",
      "minLength": 1
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "laboratory": {
      "type": "string",
      "minLength": 1
    },
    "instrument": {
      "type": "string",
      "minLength": 1
    },
    "analytical_method": {
      "type": "string",
      "minLength": 1
    },
    "software": {
      "$ref": "#softwareIdentity"
    },
    "formula_or_model": {
      "type": "string",
      "minLength": 1
    },
    "citation": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "machine_extracted",
        "reviewed",
        "verified",
        "rejected"
      ]
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "$ref": "extension.schema.json#extensionContainer"
    }
  },
  "minProperties": 1,
  "unevaluatedProperties": false,
  "$defs": {
    "software_identity": {
      "$anchor": "softwareIdentity",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        }
      },
      "unevaluatedProperties": false
    }
  }
}
