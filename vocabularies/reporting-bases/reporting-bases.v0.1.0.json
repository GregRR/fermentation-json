{
  "vocabulary": "fermentationjson.reporting_basis_kinds",
  "identifier": "https://gregrr.github.io/fermentation-json/vocabularies/reporting-bases/0.1.0",
  "version": "0.1.0",
  "status": "pre-release",
  "vocabulary_class": "extensible",
  "term_identifier_policy": "core_token_or_absolute_uri",
  "unknown_core_term_behavior": "reject",
  "unknown_uri_term_behavior": "preserve_without_inference",
  "entries": [
    {
      "id": "as_substance_equivalent",
      "requires_substance": true,
      "description": "Reported on an equivalent-mass basis of the named substance, such as alkalinity as CaCO3 or disinfectant residual as Cl2."
    },
    {
      "id": "elemental",
      "requires_substance": true,
      "description": "Reported as the named element rather than the complete molecular or ionic species."
    },
    {
      "id": "ionic",
      "requires_substance": true,
      "description": "Reported as the named ionic species."
    },
    {
      "id": "molecular",
      "requires_substance": true,
      "description": "Reported as the named molecular species."
    }
  ]
}
