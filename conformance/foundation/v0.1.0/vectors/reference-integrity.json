{
  "vector_set": "reference_integrity",
  "suite_id": "https://gregrr.github.io/fermentation-json/conformance/foundation/0.1.0/manifest.json",
  "suite_version": "0.1.0",
  "cases": [
    {
      "id": "unique-local-reference-resolves",
      "description": "Unique local object identifiers and resolvable local references conform.",
      "input": {
        "document_id": "urn:uuid:11111111-1111-4111-8111-111111111111",
        "object_ids": [
          "source-1",
          "target-1"
        ],
        "references": [
          {
            "object_id": "source-1"
          },
          {
            "document_id": "urn:uuid:11111111-1111-4111-8111-111111111111",
            "object_id": "target-1"
          },
          {
            "document_id": "urn:uuid:22222222-2222-4222-8222-222222222222",
            "object_id": "external-object"
          }
        ]
      },
      "expected": {
        "conformant": true,
        "errors": []
      }
    },
    {
      "id": "duplicate-object-id-rejected",
      "description": "Object identifiers are unique within one document.",
      "input": {
        "document_id": "urn:uuid:11111111-1111-4111-8111-111111111111",
        "object_ids": [
          "source-1",
          "source-1"
        ],
        "references": []
      },
      "expected": {
        "conformant": false,
        "errors": [
          "duplicate_object_id"
        ]
      }
    },
    {
      "id": "unresolved-local-reference-rejected",
      "description": "A reference to the current document must resolve when it includes object_id.",
      "input": {
        "document_id": "urn:uuid:11111111-1111-4111-8111-111111111111",
        "object_ids": [
          "source-1"
        ],
        "references": [
          {
            "object_id": "missing-object"
          }
        ]
      },
      "expected": {
        "conformant": false,
        "errors": [
          "unresolved_local_reference"
        ]
      }
    },
    {
      "id": "external-reference-not-required-locally",
      "description": "A different document_id is external and need not resolve in the local document.",
      "input": {
        "document_id": "urn:uuid:11111111-1111-4111-8111-111111111111",
        "object_ids": [],
        "references": [
          {
            "document_id": "urn:uuid:22222222-2222-4222-8222-222222222222",
            "object_id": "not-local"
          }
        ]
      },
      "expected": {
        "conformant": true,
        "errors": []
      }
    }
  ]
}
