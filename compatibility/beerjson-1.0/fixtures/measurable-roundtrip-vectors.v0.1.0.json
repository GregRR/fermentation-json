{
  "artifact": "fermentationjson.beerjson_measurable_roundtrip_vectors",
  "version": "0.1.0",
  "status": "pre-release",
  "source_standard": {
    "name": "BeerJSON",
    "document_version": "1.0",
    "repository_tag": "v1.0.2"
  },
  "rules": [
    "Source numeric values and BeerJSON unit tokens are semantic source information; numeric JSON lexical formatting is not required to round-trip byte-for-byte.",
    "A native_quantity vector MUST retain enough reported representation to reconstruct the BeerJSON measurable object exactly at the JSON data-model level.",
    "A source_preservation_only vector MUST retain the complete BeerJSON source object without inventing a native quantity.",
    "Canonical values are independently checked against the registered FermentationJSON unit vocabulary where the mapping is a physical or ratio-unit conversion.",
    "Same-scale analytical ranges may form one native FermentationJSON range; mixed-scale analytical ranges require explicit normalization calculation before a native range exists."
  ],
  "vectors": [
