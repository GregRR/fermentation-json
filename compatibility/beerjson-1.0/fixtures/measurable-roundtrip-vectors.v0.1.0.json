          "quantity_kind": "volume",
          "canonical": {
            "form": {
              "type": "exact",
              "value": 19.873411866
            },
            "unit": "liter"
          },
          "reported": {
            "form": {
              "type": "exact",
              "value": 5.25
            },
            "unit": "us_liquid_gallon",
            "original_unit_text": "gal"
          },
          "epistemic_state": [
            "reported"
          ]
        },
        "round_trip": "reconstruct_from_reported"
      }
    },
